    for (x, y, rz) in ((GX0 - 1.0, YY0 - 6.0, 0.0), (GX0 + 2.0, YY0 - 6.0, 0.0), (GX1 + 1.5, YY0 - 9.0, 0.0), (GX1 - 1.5, YY0 - 9.0, 0.0),
                       (GX0 - 1.0, YY0 - 12.0, 0.0), (GX0 + 2.0, YY0 - 12.0, 0.0), (GX1 + 3.5, YY0 - 7.5, 1.5708)):
