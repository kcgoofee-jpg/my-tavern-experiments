  'estate:fps': [V2S, { on: 'boolean' }],         // 调试：显示帧率——设置「显示帧率」实时同步给庄园 / props 三维子页（U，2026-09-28）
  'estate:chat': [V2S, { id: 'string' }],         // 当前 chatId：房间图集「仅本聊天」作用域用，庄园页读不到 SillyTavern 上下文（2026-09-28）
  'estate:pause': [V2S, {}],
