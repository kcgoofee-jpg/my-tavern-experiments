    for (x0, x1, y0, y1) in ((-HOLE, HOLE, -HOLE - 0.1, -HOLE), (-HOLE - 0.1, -HOLE, -HOLE, HOLE), (HOLE, HOLE + 0.1, -HOLE, HOLE)):
