def octagon(S, n=144):
    cs = [S.edge(math.pi / 8 + k * math.tau / 8) for k in range(8)]; out = []
    for k in range(8):
        (ax, ay), (bx, by) = cs[k], cs[(k + 1) % 8]
        for i in range(n // 8): t = i / (n // 8); out.append((ax + (bx - ax) * t, ay + (by - ay) * t))
    return out


def underside(ctx):
