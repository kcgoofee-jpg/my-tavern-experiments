    HERB = [C.flat('ic_herb_a', (0.09, 0.16, 0.06), 0.8, noise=0.5), C.flat('ic_herb_b', (0.16, 0.18, 0.1), 0.8, noise=0.5),
            C.flat('ic_herb_c', (0.2, 0.14, 0.22), 0.8, noise=0.5)]
    HEDGE = C.flat('ic_hedge', (0.05, 0.11, 0.05), 0.8, noise=0.5)
