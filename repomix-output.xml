# ---------------- 坡屋顶（三棱柱）----------------
def prism_mesh(name, P, colors, m=None):
    """P: (n, 7) = x, y, w, d, z0, 屋脊高, rot；屋脊沿本地 x（w 为长边）。两片坡面 + 两个山墙三角。"""
    P = np.asarray(P, np.float32).reshape(-1, 7); n = len(P)
