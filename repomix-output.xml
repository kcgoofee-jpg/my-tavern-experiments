    # ---------------- 岛体 ----------------
    def build_body(self, col):
        R = self.R
        # 台地：不规则多边形（圆角方台 / 谐波台），挡土墙只砌朝岸一侧的开口弧（≤ 220°），另一侧顺坡
        if self.terrain == 'terrace':
