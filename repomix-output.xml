                B.append(dict(p=Q, cx=float(cx), cy=float(cy), a=float(a), h=float(h), n=n, obb=ob, k=D['k'], dk=D['kind'], di=di))
            for r in d['roads']:                                      # 道路：交界大道以内的段
                Q = np.array(r['p'], np.float32) + (ox, oy); seg = [Q[0]]
