def rim(a, grow=0.0, seed=0, jit=0.0):
    """岛缘轮廓（略不规则的椭圆，岬角朝 +y 稍凸）"""
    r = 1.0 + 0.045 * math.sin(3 * a + 0.7) + 0.03 * math.sin(5 * a + 2.1) + 0.05 * max(0.0, math.sin(a)) ** 4
    if jit:
