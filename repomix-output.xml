    pts = K_.ring_at(rings, -cliff - .14 * R); K_.band(B, pts, -cliff - .14 * R, R * .014, mring, 1.03, ox); K_.band(B, pts, -cliff - .18 * R, R * .01, mring, 1.0, ox)
