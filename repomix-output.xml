    # 新泽西防撞墩迷宫（闸口 + 对外窗口前）与 Hesco 防爆墙
    def jersey(x, y, L, rz):
        M = Matrix.Translation((x, y, 0)) @ Matrix.Rotation(rz, 4, 'Z')
        prof = [(-0.3, 0.0), (0.3, 0.0), (0.3, 0.08), (0.18, 0.3), (0.1, 0.81), (-0.1, 0.81), (-0.18, 0.3), (-0.3, 0.08)]
