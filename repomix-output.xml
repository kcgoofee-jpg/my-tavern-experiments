def _ico(sub=2):
    bm = bmesh.new(); bmesh.ops.create_icosphere(bm, subdivisions=sub, radius=1)
    v = np.array([p.co[:] for p in bm.verts], np.float32); f = np.array([[p.index for p in fc.verts] for fc in bm.faces], np.int32); bm.free()
