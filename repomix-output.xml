DOORS = [mat('d%d' % i, c, .4) for i, c in enumerate([(.55, .1, .1), (.1, .25, .45), (.12, .35, .2), (.75, .55, .12)])]


def pmA():
    box(0, 0, -.5, 160, 160, .5, PAVE)
