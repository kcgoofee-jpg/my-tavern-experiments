    out = []
    for j, s in enumerate(segs):
        k_ = np.c_[np.round(s[1] * Q), np.round(s[2] * 10)]
        keep = np.any(k_ != np.roll(k_, 1, 0), axis=1)
        xy, z = s[1][keep], s[2][keep]
        if len(z) < 3 or area3(np.c_[xy * 100, z]) < .05: continue
        out.append([s[0], xy, z, j in slope])
    return out

def build(name):
