    rendered = [max(tokens(o) for o in outs) for outs in zip(*r['out'])]
    print(f'v0.9.3 自检通过：示范不生效；方位条目 {len(probes)} 个探针各只展开一层；渲染后每轮最多约 {max(rendered)} tokens')
