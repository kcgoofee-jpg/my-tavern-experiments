            x = gx + (S / 2 if round(gy / (S * .87)) % 2 else 0) + rng.uniform(-.35, .35) * S; y = gy + rng.uniform(-.3, .3) * S
            dv = dens(x, y); d = .65 * dv + .35 * lump(x, y); tint = 1.0
            if eden:                                         # 伊甸（按真实轮廓的 q）：环内侧不留缝；环外 1.6–2.6 一道浓带，环本身另排
