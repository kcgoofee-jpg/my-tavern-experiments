            TR.box(x_ * TRANS_HW, x_ * (TRANS_HW + 0.4), s * 8, s * TRANS_Y, EAVE, EAVE + 1.5, STONE_D)

    # ------------------------------------------------------------ 唱诗堂 + 后殿 + 放射状小礼拜堂
    AP = Batch('props_apse')
    c0, c1 = CHOIR_X
    AP.box(c0, c1, -yw, yw, 0, EAVE, STONE)
