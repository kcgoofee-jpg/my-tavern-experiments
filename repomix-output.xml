        print('pasted', iid, path, cut.size, 'at', (round(cx), round(cy)))
    dst = a.out or a.full
    full.convert('RGB').save(dst)
    if a.dzi:
        subprocess.check_call([sys.executable, os.path.join(ROOT, 'tools/make_dzi.py'), dst, a.dzi])


