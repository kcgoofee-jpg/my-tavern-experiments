        vs = [(-L/2, -W/2, 0), (L/2, -W/2, 0), (L/2, W/2, 0), (-L/2, W/2, 0), (-L/2, 0, h), (L/2, 0, h)]
        fs = [(3, 2, 1, 0), (0, 1, 5, 4), (2, 3, 4, 5), (1, 2, 5), (3, 0, 4)]
    else:
        vs = [(-W/2, -L/2, 0), (W/2, -L/2, 0), (W/2, L/2, 0), (-W/2, L/2, 0), (0, -L/2, h), (0, L/2, h)]
        fs = [(3, 2, 1, 0), (0, 1, 4), (2, 3, 5), (1, 2, 5, 4), (3, 0, 4, 5)]
