    for k in range(0, len(r1), 9): x, y = r1[k]; B.cyl(x, y, z - R * .01, R * .012, R * .02, ml, 8)
    z2 = -cliff - .45 * R; p2 = K_.ring_at(rings, z2); x, y = p2[int(len(p2) * .72)]
