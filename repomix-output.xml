def island_ring(n=96, grow=0.0, jitter=0.0, seed=1):
    rnd = random.Random(seed)
    pts = []
    for i in range(n):
        a = i * math.tau / n
        c, s = math.cos(a), math.sin(a)
        rx = (ISL_R[0] + grow) * (abs(c) ** (2 / ISL_P)) * (1 if c >= 0 else -1)
        ry = (ISL_R[1] + grow) * (abs(s) ** (2 / ISL_P)) * (1 if s >= 0 else -1)
