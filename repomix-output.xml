            if abs(cx) > HW or abs(cy) > HH: continue                  # 与 tc_osm 相同：中心在取材框里的楼
            zg = min(f[1][:, 2].min() for f in faces if f[0] == 0) if any(f[0] == 0 for f in faces) else A[:, 2].min()
