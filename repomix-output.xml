            if dv < .3 and d < .3: continue                  # 云缝只由低频浓度决定：lump 造成的小黑洞被填上
            R = (st['R0'] + st['R1'] * (d - .3)) * rng.uniform(.85, 1.15)
            top = -.1 + .8 * (d - .3) + rng.uniform(-.08, .08)
