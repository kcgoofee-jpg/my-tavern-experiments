    rep.check(`${name} 选择器：地标 / 层 / 庄园房间 / 室外 / 世界地名五组，不超出屏宽`, d.open && d.groups.length === 5 && d.sheet <= d.vw, JSON.stringify(d));
    await p.locator('#umQ').fill('女仆长寝室'); await B.wait(200);
    await B.shot(p, OUT, `um_${name}_picker`);
