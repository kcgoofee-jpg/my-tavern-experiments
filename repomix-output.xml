        """玻璃幕墙：玻璃面 + 竖梃 + 横梁"""
        fbox(B, side, c, u0, u1, z0, z1, -0.1, 0.0, gm)
        n = int(round((u1 - u0) / mu))
        for i in range(n + 1):
            u = u0 + (u1 - u0) * i / n
            fbox(B, side, c, u - 0.06, u + 0.06, z0, z1, 0, fin, mm)
        z = z0
        while z <= z1 + 0.01:
            fbox(B, side, c, u0, u1, z - 0.08, z + 0.08, 0, 0.12, mm)
            z += mz

