                _box(bm, x - 0.06, y - 0.06, 0, x + 0.06, y + 0.06, 3.5)
        parts['post'] = (bm, M['steel'])
        for k, (bm, m) in parts.items():
            ob = bm_to_obj(bm, f'tennis{i}_{k}', col, m)
            ob.location = (cx, cy, z); ob.rotation_euler.z = rot


