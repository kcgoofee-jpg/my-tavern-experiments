    bmesh.ops.transform(occ.bm, verts=ret['verts'], matrix=Matrix.Translation((ix, iy, 1.4)) @ Matrix.Rotation(rot, 4, 'Z') @ Matrix.Diagonal((rx * 1.05, ry * 1.05, 1, 1)))
