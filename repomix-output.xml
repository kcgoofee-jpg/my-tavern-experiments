            tri = [(-W / 2, B_top - 1.2), (W / 2, B_top - 1.2), (0, B_top - 1.2 + W * 0.85)]
            C.slab2d(B, M, tri, d - 0.5, d, STONE)
            C.frame2d(B, M, tri, 0.35, d, d + 0.2, STONE_D)
            C.frame2d(B, M, circle(W * 0.14, 18, 0, B_top - 1.2 + W * 0.3), 0.12, d, d + 0.15, STONE_D)
