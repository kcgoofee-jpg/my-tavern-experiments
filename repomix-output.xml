  const EX = { zh: [{ label: '默认', go: '前往{name}。', ask: '关于{name}，' }, { label: '第一人称', go: '我动身前往{name}。', ask: '我想多了解一下{name}：' }, { label: '旁白提示', go: '（场景切换到{name}）', ask: '（请详细描写{name}的情况）' }],
