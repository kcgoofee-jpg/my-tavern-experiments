    per_face = np.concatenate([np.repeat(C, 2, 0).reshape(n, 2, 4).reshape(-1, 4), np.repeat(C, 2, 0)])   # 坡面、山墙同色
    cols = np.concatenate([np.repeat(per_face[:len(Q)], 4, 0), np.repeat(per_face[len(Q):], 3, 0)])
