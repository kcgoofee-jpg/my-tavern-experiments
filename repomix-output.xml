AETHER_C = (0.55, 0.88, 1.0)


def glow(name, c=AETHER_C, estr=6.0, alpha=1.0):
    """自发光材质；alpha < 1 时半透明（结界、场环），不投影由调用方对物体设 visible_shadow = False。"""
