    ex, ey = cx + arm_dx, cy + arm_dy
    x0, x1 = sorted((cx, ex)); y0, y1 = sorted((cy, ey))
    K.box('white', x0 - 0.08, y0 - 0.08, CLEAR - 0.42, x1 + 0.08, y1 + 0.08, CLEAR - 0.3)
    K.cyl('white', ex, ey, CLEAR - 0.42, CLEAR - 0.15, 0.1)
