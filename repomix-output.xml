PARK_L = []                                                             # 大公园沿边几盏暗钠灯（小路的灯），公园的轮廓在缩小时读得出
for P_ in _bigp:
    for a_, b_ in zip(P_, np.roll(P_, -1, 0)):
        L_ = float(np.hypot(*(b_ - a_)))
