  const gc = { id: 'char', label: en ? 'People' : '人物', short: en ? 'People' : '人物', items: [] };
  for (const n of chars) add(gc, { key: String(n), kind: 'character', target: { character: String(n) }, sub: '', en: '', alias: [] });
  if (gc.items.length) out.push(gc);
