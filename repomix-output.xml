def _q(eden, x, y):
    """到伊甸的「轮廓倍数」：点到岛心距离 / 该方向的岸线半径（标量或 numpy）。"""
    isle = eden['isle']; c, s = math.cos(-eden['rot']), math.sin(-eden['rot']); dx, dy = x - eden['x'], y - eden['y']
    lx, ly = dx * c - dy * s, dx * s + dy * c
