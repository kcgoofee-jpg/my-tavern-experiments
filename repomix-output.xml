    o.host.appendChild(el); paintTabs(); paint();
    return {
      el, head, body, lead, grip, set, setTab, destroy, down, cycle, label, setName, showTab, addTab, report,
      panel: id => tabs.get(id)?.p || null, button: id => tabs.get(id)?.b || null,
