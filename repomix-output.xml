        elif hi_side == 'W':
            vs = [(x0, y0, zhi), (x1, y0, zlo), (x1, y1, zlo), (x0, y1, zhi)]
        else:
            vs = [(x1, y0, zhi), (x1, y1, zhi), (x0, y1, zlo), (x0, y0, zlo)]
        vs2 = [(v[0], v[1], v[2] + 0.25) for v in vs]
        K.poly(vs + vs2, [(0, 1, 2, 3), (7, 6, 5, 4), (0, 4, 5, 1), (1, 5, 6, 2), (2, 6, 7, 3), (3, 7, 4, 0)], SLATE)
