        nt.links.new(nz.outputs[0], bp.inputs['Height']); nt.links.new(bp.outputs[0], b.inputs['Normal'])
        b.inputs['Roughness'].default_value = 1.0
        b.inputs['Subsurface Weight'].default_value = 0.3
