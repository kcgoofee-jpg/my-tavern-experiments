  await F.click('[data-mode=flow]'); expect(await stepLabel(F, 'tank')).toEqual(['老白', '奶罐与制冷']);
  await editViaHub(P, 'dairy:vacuum', { name: '呼噜机' }); await editViaHub(P, 'dairy:receiver', { note: '先看这里有没有堵' });
  const inj = await H.injected(); expect(inj).toContain('奶罐与制冷→老白'); expect(inj).not.toContain('dairy:');
  expect(inj).toContain(await P.textContent('.preview code'));   // 预览片段逐字出现在实际注入里
  expect(await H.wbEntry()).toMatch(/玩家称为「老白」/);
  await P.reload(); /* 再断言 */ await H.switchChat('B'); /* 断言为空 */ await H.switchChat('A');
  await H.pushMessage('⌖改名 奶罐与制冷 → 冷库一号'); /* 断言待定、接受、历史恢复 */
  await H.pushMessage('⌖用途 清洗喷头：CIP 前先检查'); /* 断言直接生效 */
