        b0, b1 = h * (1 - s_) / 2 + 0.1 * i, h * (1 + s_) / 2
        B.poly([P(a0, b0, d), P(a1, b0, d), P(a1, b1, d), P(a0, b1, d)], [(0, 1, 2, 3), (3, 2, 1, 0)], holos[i % len(holos)])


