            if not RS: continue
            if ground is None: ground = segs[0][1]
            if ring_area(ground) < 0: ground = ground[::-1]
            big = [r for r in RS if r[1] >= RH_M2] or RS
            rh = max(r[0] for r in big)
            thr = max(TOP_M2, .03 * abs(ring_area(ground)) * 1e4)
