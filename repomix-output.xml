    TRACK = C.flat('ic_track', (0.36, 0.14, 0.1), 0.9, noise=0.3)
    SAND = C.flat('ic_sand', (0.3, 0.22, 0.15), 0.95, noise=0.5)
    LINE = C.flat('ic_line', (0.85, 0.85, 0.82), 0.6)
