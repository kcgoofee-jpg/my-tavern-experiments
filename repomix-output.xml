  'eden-map:explore-reset': [V2H, {}],
  'eden-map:th': [V2H, { op: 'string' }],   // 酒馆助手设置（app/th-ui.mjs）：state / prefs / wb-inspect / wb-write / wb-del-legacy
  // 宿主 → 查看器
  'eden-map:here': [H2V, { value: 'any' }],
