    // 自定义面板：列出叫法，可去掉
    await p.evaluate(() => { showSet(true); document.querySelector('#cuBox .cu-open').click(); }); await B.wait(500);
    const al = await p.evaluate(() => [...document.querySelectorAll('#cuDlg [data-unalias]')].map(b => b.dataset.a));
