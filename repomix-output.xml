export function insert(win, text, slash) {
  text = clip(String(text ?? '').replace(/[\r\n]+/g, ' '), MAX); if (!text.trim()) return '';
  let ta = null; try { ta = win?.document?.getElementById('send_textarea'); } catch (e) {}
  if (ta && 'value' in ta) {
