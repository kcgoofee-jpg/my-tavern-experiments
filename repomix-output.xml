  is('厨房花园', 2, 'eden_estate', { word: '厨房花园' });   // 区域名里含房间名（厨房）：取更长的区域
  is('伊甸庄园后庭浴室', 1, 'eden_estate');                  // 房间与区域都有：偏向房间
});
