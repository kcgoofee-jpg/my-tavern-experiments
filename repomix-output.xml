# ---------------- 片区：按参考城市分（tc_city.DISTRICTS['low']）----------------
# 工业带（鲁尔区）：大轮廓 → 厂房，小轮廓 → 工人住宅（旧城）；城中村（深圳 + 九龙城寨的密度）：握手楼，屋顶极密
def blackout(x, y): return math.sin(x * .41 + 2.1) * math.cos(y * .37 + .4) + .4 * math.sin(x * .9 - y * .7) > 1.0   # 断电的片区
