    _, a, u0, u1, v0, v1 = best; c, s = math.cos(a), math.sin(a); uc, vc = (u0 + u1) / 2, (v0 + v1) / 2
    w, d = u1 - u0, v1 - v0
    if d > w: w, d, a = d, w, a + math.pi / 2
