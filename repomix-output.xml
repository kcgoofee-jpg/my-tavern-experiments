        self.ground([(.26 * math.cos(t) * (1 + .1 * math.sin(3 * t + 1.1)), .02 + .22 * math.sin(t) * (1 + .07 * math.sin(2 * t + .4))) for t in np.linspace(0, TAU, 20, endpoint=False)], wall=True, gate=15)
