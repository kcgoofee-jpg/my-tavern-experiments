    `<button class="rg-x" type="button" aria-label="${zh ? '关闭' : 'Close'}">✕</button>` +
    `<button class="rg-p" type="button" aria-label="${zh ? '上一张' : 'Previous'}">‹</button>` +
    `<button class="rg-n" type="button" aria-label="${zh ? '下一张' : 'Next'}">›</button>`;
