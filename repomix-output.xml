        P, U, V = Vector(P), Vector(U), Vector(V)
        n = U.cross(V).normalized()
        L = U.length
        k = max(4, int(L / pitch * 4))
        pat = (0.0, 1.0, 1.0, 0.0)
        vs = []
        for i in range(k + 1):
            o = P + U * (i / k) + n * (depth * pat[i % 4])
            vs.append(tuple(o)); vs.append(tuple(o + V))
        fs = [(2 * i, 2 * i + 2, 2 * i + 3, 2 * i + 1) for i in range(k)]
        B.poly(vs, fs, m)

