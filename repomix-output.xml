            rbox(B, *P(sx * W * 0.55, -L - 0.01, 0.62), 0.55, 0.04, 0.07, LAMPC, rz=rz)      # 前灯条
            rbox(B, *P(sx * W * 0.55, L + 0.01, 0.75), 0.5, 0.04, 0.06, RED, rz=rz)          # 尾灯条
        top = 2.25 if van else 1.52
