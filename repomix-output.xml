        mx = nt.nodes.new('ShaderNodeMixRGB'); mx.blend_type = 'MULTIPLY'; mx.inputs['Fac'].default_value = 1
        if last is None: mx.inputs['Color1'].default_value = (*color, 1)
        else: nt.links.new(last, mx.inputs['Color1'])
