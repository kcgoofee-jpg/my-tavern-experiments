<file path="map/data/schema/events.schema.json">
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "设定包事件分类 map/packs/<id>/events.json",
  "description": "事件标签（⌖类别｜层·地点｜等级｜一句话｜发布方 或 data-tcmap）的类型表：大类（颜色 / 形状 = 图例）、具体类型、别名、层与地名为地图自设。map/tavern/events.mjs configure() 读入；eden 用内置表。",
  "type": "object",
  "required": ["groups", "types", "layers"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "groups": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "description": "大类 → 颜色" },
    "order": { "type": "array", "items": { "type": "string" }, "description": "图例顺序（缺省 = groups 的键顺序）" },
    "shapes": { "type": "object", "additionalProperties": { "enum": ["hex", "circle", "square", "penta", "diamond", "octa", "tri-down", "tri", "ring"] } },
    "types": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object", "required": ["g", "ch"], "additionalProperties": false,
      "properties": { "g": { "type": "string" }, "ch": { "type": "string", "minLength": 1 }, "src": { "type": "string" }, "rare": { "type": "integer", "minimum": 1, "maximum": 4 } } } },
    "alias": { "type": "object", "additionalProperties": { "type": "string" } },
    "layers": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "map"], "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "map": { "type": "string" }, "match": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "地名里出现这些词就算这一层" } } } },
    "closed": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "状态写这些词 = 事件结束（缺省 = 核心的 解除 / 结束 / 恢复…）" },
    "region": { "type": "string", "description": "地区名：地点前缀里写了就去掉（「雾港镇·码头·鱼市」→ 码头 / 鱼市）" },
    "outside": { "type": "string", "description": "界外层名（地名包含层名时不按包含匹配这一层）" },
    "tag": { "type": "string", "description": "注入给模型那句话的方括号标签（缺省「地图事态」）" },
    "examples": { "type": "array", "items": { "type": "string" }, "description": "世界书里的示范标记原文：模型照抄时不上图" }
  }
}
</file>

<file path="map/data/schema/pack.schema.json">
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "设定包清单 map/packs/<id>/manifest.json",
  "description": "一张卡 = 一个设定包：核心（查看器、事件解析、定位、扩展接口）只经 map/core/pack.mjs 读这里。路径相对清单所在目录（eden 相对 map/）。写法见 docs/generalize/README.md；tools/check_pack.py 校验结构与跨文件一致性。v1 已冻结（2026-09-28，docs/pack-schema-v1.md）：只许加可选字段，改名 / 删字段 / 改必填要升 schema 2 并写迁移；tests/pack_schema_v1.test.mjs 把关。",
  "type": "object",
  "required": ["id", "schema", "title", "data"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$", "description": "包 id = 目录名；本机存储前缀由它推出（eden → edenMap，其它 → tcp.<id>.），不可另配" },
    "schema": { "const": 1, "description": "清单格式版本" },
    "title": { "type": "string", "minLength": 1, "description": "地图面板标题" },
    "title_en": { "type": "string" },
    "chat": { "type": "object", "additionalProperties": false, "description": "聊天变量（酒馆助手 chat 变量；从不写卡自己的 stat_data）",
      "properties": { "var": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$", "description": "顶层键；默认 tc_<id>（eden 为历史名 eden_map）。键内结构（自定义 / 探索 / 行程…）由核心定义" } } },
    "data": { "type": "object", "required": ["maps"], "additionalProperties": false, "description": "数据文件（相对清单目录）；缺省 = 这项功能不开",
      "properties": {
        "maps": { "$ref": "#/$defs/path", "description": "地图注册表（结构 = maps.schema.json；里面的 base / data 路径也相对包目录）" },
        "world": { "$ref": "#/$defs/path", "description": "世界图地点（places / fiefs / realms）；没有世界图的包不写" },
        "derived": { "$ref": "#/$defs/path" },
        "rooms": { "$ref": "#/$defs/path", "description": "分层房间平面（庄园类室内图）" },
        "events": { "anyOf": [ { "const": "builtin" }, { "$ref": "#/$defs/path" } ], "description": "事件分类（结构 = events.schema.json）；builtin = 核心自带的天城分类（只有 eden 用）" },
        "worldbook": { "$ref": "#/$defs/path", "description": "世界书附加条目源文件（给模型的地图联动规范）" }
      } },
    "vars": { "type": "object", "additionalProperties": { "type": "string" }, "description": "MVU stat_data 默认路径（键 = tavern/adapter.mjs FIELDS：location / time / date / outfit / present…）；没写的按字段名自动发现，用户仍可在设置「变量映射」里改" },
    "cdn": { "type": "object", "additionalProperties": false,
      "properties": { "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "description": "GitHub owner/repo（jsDelivr gh 线路）" }, "npm": { "type": "string" } } },
    "theme": { "type": "object", "additionalProperties": false,
      "properties": { "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "强调色（悬浮按钮、选中态）" } } },
    "features": { "type": "object", "additionalProperties": { "type": "boolean" }, "description": "开关覆盖（world / estate…），默认按有没有对应数据推出" },
    "strings": { "type": "object", "additionalProperties": { "type": "string" }, "description": "包内文案（悬浮按钮提示等），键名见 docs/generalize/README.md" },
    "worldbook": { "type": "object", "additionalProperties": false, "properties": { "addon": { "type": "string" } }, "description": "（eden 历史字段）附加条目生成脚本" }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![a-zA-Z]+:)(?!/)(?!.*\\.\\.)[^\\s\\\\]+$" }
  }
}
</file>

<file path="map/data/schema/points.schema.json">
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "points.schema.json",
  "title": "points 地图的渲染数据（map/data/tc_*.json、site_*.json，maps.json 里 maps.<id>.data 指向的文件）",
  "description": "由渲染脚本导出：标记的归一化坐标、上层的岛与航线。名称、出处等元数据在 maps.json 的 markers 里，这里只放几何。",
  "type": "object",
  "required": ["extent_m", "markers"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "extent_m": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 }, "description": "底图覆盖的 [宽, 高]（米）" },
    "layer": { "type": ["string", "null"] },
    "markers": { "type": "array", "items": { "type": "object", "required": ["id", "nx", "ny"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "nx": { "$ref": "#/$defs/unit" }, "ny": { "$ref": "#/$defs/unit" },
        "r": { "type": "number", "minimum": 0 }, "ax": { "$ref": "#/$defs/unit" }, "ay": { "$ref": "#/$defs/unit" },
        "manual": { "type": "boolean", "description": "手工摆放（渲染脚本不覆盖）" } } } },
    "islands": { "type": "array", "items": { "type": "object", "required": ["id", "nx", "ny"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "nx": { "$ref": "#/$defs/unit" }, "ny": { "$ref": "#/$defs/unit" },
        "rx": { "type": "number", "minimum": 0 }, "ry": { "type": "number", "minimum": 0 }, "rot": { "type": "number" }, "alt_m": { "type": "number" },
        "estate_style": { "type": "string" }, "shape": { "type": "string" }, "rim": { "type": "string" }, "terrain": { "type": "string" },
        "layout": { "type": "string" }, "plan": { "type": "string" }, "role": { "type": "string" },
        "outline": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/pt" } } } } },
    "routes": { "type": "array", "items": { "type": "object", "required": ["kind", "pts"], "additionalProperties": false,
      "properties": { "kind": { "enum": ["lane", "patrol", "patrol_city"] }, "from": { "type": "string" }, "to": { "type": "string" }, "pts": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/pt" } } } } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "pt": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/unit" } }
  }
}
</file>

