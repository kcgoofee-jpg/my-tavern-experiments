def tree_fine(B, x, y, h, r, seed=0, z=0.0, n=520, size=0.16):
    """细叶行道树：主干 + 3–4 根主枝 + 若干小叶卡簇（叶卡比 tree() 小、数量适中，适合近景且三角面省）"""
