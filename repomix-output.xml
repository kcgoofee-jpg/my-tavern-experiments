            if big and k == 0: a = -math.pi / 2 + .62                                   # 伊甸东南缘露岩的楔形
            if any(abs(math.remainder(a - b, 2 * math.pi)) < .5 for b in avoid): continue
            if any(abs(math.remainder(a - b, 2 * math.pi)) < .6 for b in angs): continue
