        K.box('brushed', ex - 0.04, ey - 0.26, 1.9, ex + 0.04, ey - 0.16, 2.0)
    else:
        for i in range(3):                                                           # 电源插座 / 数据口块
            K.box('grey', ex - 0.23, ey - 0.12 + i * 0.1, 1.75, ex - 0.22, ey - 0.05 + i * 0.1, 1.85)
        K.box('white', ex - 0.22, ey - 0.2, 1.48, ex + 0.2, ey + 0.18, 1.7)            # 电外科主机


