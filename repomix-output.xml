    if r_ < .55: RB.append((x, y, w * _rbr.uniform(.7, .95), d * _rbr.uniform(.7, .95), 0, _rbr.uniform(.002, .008))); RBR.append(rot); RBC.append(np.array((.075, .066, .056)) * _rbr.uniform(.55, .95))
    elif r_ < .85:
        for _ in range(int(_rbr.integers(3, 8))):
