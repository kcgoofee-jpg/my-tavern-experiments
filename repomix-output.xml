    return { zoom: v.getZoom(true), sx: p.x + r.left, sy: p.y + r.top }; });
  return { zoom0: +before.toFixed(3), zoom1: +after.zoom.toFixed(3), drift_px: +Math.hypot(after.sx - x, after.sy - y).toFixed(2) };
