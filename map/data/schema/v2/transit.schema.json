{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2/transit.schema.json",
  "title": "transit block, schema 2: stations, lines, links, districts",
  "description": "docs/kernel-schema.md §9 (K-R107 the block, K-R109 the router) and docs/transit-schema.md §2. Optional: a pack without it has no network. Stations are nodes of the pack's tree or free points on a view; lines (ordered stops, minutes per segment) generate the ride edges, links add walk transfers and single hops; districts carry a function and a danger level. Limits (the run-time check heals, the tools are strict, K-R06): at most 300 stations, 24 lines of at most 80 stops, 600 links, 64 districts of at most 200 points, 8 modes in all (4 kernel defaults walk, metro, maglev, air plus the pack's), the block at most 256 KB of JSON. A mode row with a kernel id overrides label, i18n, color and dash only; a new mode needs label and trip.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^_": {},
    "^x-": {}
  },
  "required": [
    "stations"
  ],
  "properties": {
    "modes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,15}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mode"
      }
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/station"
      }
    },
    "lines": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 600,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "districts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/district"
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "transfer_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "Minutes added when boarding another line after a ride (default 3)."
        },
        "walk_m_per_min": {
          "type": "number",
          "minimum": 20,
          "maximum": 200,
          "description": "Walking speed for access legs and the direct walk (default 80)."
        },
        "access_max_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Longest walk access leg, 0 = node attachment only (default 12)."
        },
        "detour": {
          "type": "number",
          "minimum": 1,
          "maximum": 2,
          "description": "Straight-line distance times this = walking distance (default 1.25)."
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "functions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/function"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^_": {},
              "^x-": {}
            },
            "properties": {
              "color": {
                "$ref": "#/$defs/color"
              }
            },
            "required": [
              "color"
            ]
          }
        },
        "width": {
          "type": "number",
          "minimum": 2,
          "maximum": 8,
          "description": "Line width in px (default 4)."
        },
        "labels": {
          "type": "boolean",
          "description": "Draw district and station labels (default true)."
        }
      }
    }
  },
  "$defs": {
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
    },
    "color": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|--(accent|ink|bg|surface|line|muted|gold|ok|alert|on|map-label|glow|focus|r|fs)(-[a-z0-9-]{1,30})?)$",
      "description": "#rrggbb or a kernel colour token name (K-R58)."
    },
    "function": {
      "type": "string",
      "enum": [
        "civic",
        "commerce",
        "residential",
        "industry",
        "military",
        "religious",
        "education",
        "medical",
        "leisure",
        "transport",
        "nature",
        "restricted",
        "other"
      ],
      "description": "The fixed kernel list; an unknown value becomes other at run time."
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^[^\\n]{1,24}$"
        },
        "i18n": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^_": {},
              "^x-": {}
            },
            "properties": {
              "label": {
                "type": "string",
                "pattern": "^[^\\n]{1,24}$"
              }
            },
            "required": [
              "label"
            ]
          }
        },
        "trip": {
          "type": "string",
          "enum": [
            "road",
            "rail",
            "underground",
            "air",
            "teleport"
          ],
          "description": "The trip drawing class the mode belongs to (a kernel mode keeps its own)."
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "dash": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 40
          }
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "A node of the pack's tree: the station is drawn where the node is drawn."
        },
        "view": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "at": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "name": {
          "type": "string",
          "pattern": "^[^\\n]{1,40}$"
        },
        "i18n": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^_": {},
              "^x-": {}
            },
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[^\\n]{1,40}$"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "district": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "hidden": {
          "type": "boolean",
          "description": "Kept for routing, no dot drawn (a transfer corridor)."
        }
      },
      "required": [
        "id"
      ],
      "anyOf": [
        {
          "required": [
            "node"
          ]
        },
        {
          "required": [
            "view",
            "at",
            "name"
          ]
        }
      ]
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "number": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,3}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[^\\n]{1,40}$"
        },
        "i18n": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^_": {},
              "^x-": {}
            },
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[^\\n]{1,40}$"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "mode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,15}$"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "A hex colour, never a token: lines are told apart by colour."
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 80,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "min": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.1,
              "maximum": 600
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 80,
              "items": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 600
              }
            }
          ],
          "description": "Minutes of each segment: one number, or an array of stops-1 numbers (stops when loop)."
        },
        "loop": {
          "type": "boolean"
        },
        "oneway": {
          "type": "boolean"
        },
        "wait": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      },
      "required": [
        "id",
        "name",
        "mode",
        "color",
        "stops",
        "min"
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "mode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,15}$"
        },
        "min": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 600
        },
        "oneway": {
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to",
        "mode",
        "min"
      ]
    },
    "district": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[^\\n]{1,40}$"
        },
        "i18n": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^_": {},
              "^x-": {}
            },
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[^\\n]{1,40}$"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "view": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "pts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 200,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "r": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.5,
          "description": "Radius as a fraction of the width, with node and no pts (default 0.06)."
        },
        "function": {
          "$ref": "#/$defs/function"
        },
        "danger": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "id",
        "name",
        "view",
        "function"
      ],
      "anyOf": [
        {
          "required": [
            "pts"
          ]
        },
        {
          "required": [
            "node"
          ]
        }
      ]
    }
  }
}
