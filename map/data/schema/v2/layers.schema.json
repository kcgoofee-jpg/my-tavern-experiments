{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2/layers.schema.json",
  "title": "layers block, schema 2: declarative layers",
  "description": "docs/kernel-schema.md §9 (K-R56, K-R79 layers, K-R81 sources and features, K-R82 applies, K-R83 menu) and docs/layers-schema.md. A row whose id is a kernel layer id only adjusts menu, applies, legend and off (other fields are ignored at run time); any other row declares a layer and needs type, slot and a source or data (the run-time check reports layer-incomplete). Limits: 32 new layers, 1000 features, 2000 points, 8 legend rows, 16 style.by kinds. Absent block = the engine's built-in default layers.",
  "type": "array",
  "maxItems": 64,
  "$defs": {
    "style_line": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|--(accent|ink|bg|surface|line|muted|gold|ok|alert|on|map-label|glow|focus|r|fs)(-[a-z0-9-]{1,30})?)$",
          "description": "#rrggbb, #rrggbbaa or a kernel colour token name (K-R58)."
        },
        "width": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "dash": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 40
          }
        },
        "halo": {
          "type": "boolean"
        }
      }
    },
    "style_base": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|--(accent|ink|bg|surface|line|muted|gold|ok|alert|on|map-label|glow|focus|r|fs)(-[a-z0-9-]{1,30})?)$",
          "description": "#rrggbb, #rrggbbaa or a kernel colour token name (K-R58)."
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "size": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0.5,
              "maximum": 32
            },
            {
              "enum": [
                "micro",
                "small",
                "body"
              ]
            }
          ],
          "description": "point 4..32 px, flow 0.5..6 px, label micro | small | body (clamped per block at run time)."
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "description": "A kernel icon name (prop: icons are for local layers only, K-R88)."
        },
        "pulse": {
          "type": "boolean"
        },
        "tone": {
          "enum": [
            "plain",
            "chip"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "dash": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 40
          }
        },
        "halo": {
          "type": "boolean"
        },
        "fill": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|--(accent|ink|bg|surface|line|muted|gold|ok|alert|on|map-label|glow|focus|r|fs)(-[a-z0-9-]{1,30})?)$",
          "description": "#rrggbb, #rrggbbaa or a kernel colour token name (K-R58)."
        },
        "fill_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "speed": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 1
        },
        "density": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "trail": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "preset": {
          "enum": [
            "rain",
            "storm",
            "sand",
            "snow"
          ]
        },
        "path": {
          "$ref": "#/$defs/style_line",
          "description": "flow: the line drawn beneath the moving dots (absent = none, L-04)."
        },
        "by": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/style_plain"
          }
        }
      }
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "view": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "at": {
          "$ref": "#/$defs/point2",
          "description": "0..1 of the view's width and height (K-R31)."
        },
        "node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "pts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/point2"
          }
        },
        "closed": {
          "type": "boolean"
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "i18n": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "style_plain": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {},
        "^x-": {}
      },
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|--(accent|ink|bg|surface|line|muted|gold|ok|alert|on|map-label|glow|focus|r|fs)(-[a-z0-9-]{1,30})?)$",
          "description": "#rrggbb, #rrggbbaa or a kernel colour token name (K-R58)."
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "size": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0.5,
              "maximum": 32
            },
            {
              "enum": [
                "micro",
                "small",
                "body"
              ]
            }
          ],
          "description": "point 4..32 px, flow 0.5..6 px, label micro | small | body (clamped per block at run time)."
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "description": "A kernel icon name (prop: icons are for local layers only, K-R88)."
        },
        "pulse": {
          "type": "boolean"
        },
        "tone": {
          "enum": [
            "plain",
            "chip"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "dash": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 40
          }
        },
        "halo": {
          "type": "boolean"
        },
        "fill": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|--(accent|ink|bg|surface|line|muted|gold|ok|alert|on|map-label|glow|focus|r|fs)(-[a-z0-9-]{1,30})?)$",
          "description": "#rrggbb, #rrggbbaa or a kernel colour token name (K-R58)."
        },
        "fill_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "speed": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 1
        },
        "density": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "trail": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "preset": {
          "enum": [
            "rain",
            "storm",
            "sand",
            "snow"
          ]
        },
        "path": {
          "$ref": "#/$defs/style_line"
        }
      }
    }
  },
  "items": {
    "type": "object",
    "required": [
      "id"
    ],
    "additionalProperties": false,
    "patternProperties": {
      "^_": {},
      "^x-": {}
    },
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      },
      "type": {
        "enum": [
          "point",
          "area",
          "line",
          "label",
          "tint",
          "particles",
          "flow",
          "sound"
        ],
        "description": "Kernel rendering building block (K-R80, S8-2 draws them)."
      },
      "slot": {
        "enum": [
          "base",
          "depth-haze",
          "fog",
          "routes",
          "trips",
          "events",
          "markers",
          "labels",
          "fx",
          "interaction"
        ],
        "description": "One of the ten fixed viewport slots, bottom to top."
      },
      "source": {
        "type": "string",
        "pattern": "^(inline|events|people|items|routine|ops|view:(routes|markers)|file:[^\\n]{1,200}\\.json|mvu:[^\\n]{1,80})$",
        "description": "K-R81. Absent with data = inline. A pack cannot use kernel."
      },
      "data": {
        "type": "object",
        "description": "Inline data: { features: Feature[] } (at most 1000), or the sound data of a sound layer.",
        "properties": {
          "features": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/feature"
            }
          }
        }
      },
      "filter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kinds": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          }
        }
      },
      "applies": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^_": {},
          "^x-": {}
        },
        "description": "K-R82: every key given must match; absent = everywhere.",
        "properties": {
          "views": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "kinds": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          },
          "nodes": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "node_types": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          },
          "periods": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "dark": {
            "type": "boolean"
          },
          "data": {
            "type": "boolean"
          },
          "mvu": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "equals": {},
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "truthy": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "style": {
        "$ref": "#/$defs/style_base",
        "description": "K-R80 style keys; by = per-kind overrides (at most 16 kinds)."
      },
      "menu": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^_": {},
          "^x-": {}
        },
        "description": "K-R83. A new layer needs a label; a kernel row may give only the fields it adjusts.",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "default": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "i18n": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "legend": {
        "type": "array",
        "maxItems": 8,
        "description": "Legend rows (K-R84, drawn by S8-2).",
        "items": {
          "type": "object",
          "required": [
            "label"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^_": {},
            "^x-": {}
          },
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "desc": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "i18n": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "desc": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "off": {
        "type": "boolean",
        "description": "Kernel ids only: keep the layer registered but invisible and without a menu row."
      }
    }
  }
}
