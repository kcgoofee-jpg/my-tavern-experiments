{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maps.schema.json",
  "title": "地图注册表 map/data/maps.json",
  "description": "结构（字段、类型、枚举）由本文件约束，tools/check_maps.py 每次都校验；跨文件的一致性（指向的地图 / 标记存在、坐标对齐、瓦片在不在）仍由 check_maps.py 的逐项检查负责。加字段：在同一个提交里先在这里登记（写 description），再写数据——未登记的字段 check_maps 报错。以 _ 开头的键（注释 / 草稿备注）任何对象里都放行。",
  "type": "object",
  "required": ["start", "groups", "maps"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "start": { "type": "string", "description": "首次打开的地图 id" },
    "groups": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/group" } },
    "unplaced": { "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} }, "properties": { "items": { "type": "array" } } },
    "ambiguous": { "type": "object", "additionalProperties": false, "patternProperties": { "^_": {} }, "properties": { "words": { "$ref": "#/$defs/strList" } }, "description": "泛称：当前地点只写这些词时不落到任何地标（map/here.mjs）" },
    "feeds": { "type": "array", "description": "外部事件数据源（map/events.mjs 定时拉取）", "items": { "type": "object", "required": ["url"], "additionalProperties": false,
      "properties": { "url": { "type": "string" }, "label": { "type": "string" }, "every": { "type": "number", "minimum": 60 } } } },
    "maps": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/map" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "str": { "type": "string", "minLength": 1 },
    "strList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "strListNE": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^\\s]+$", "description": "相对 map/ 的路径" },
    "group": { "type": "object", "required": ["title", "layers"], "additionalProperties": false, "patternProperties": { "^_": {} },
      "properties": {
        "title": { "$ref": "#/$defs/str" }, "title_en": { "$ref": "#/$defs/str" },
        "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "description": "同组各层（层切换器顺序）" },
        "place": { "$ref": "#/$defs/id", "description": "世界图上的地点 / 封地 id（尺度交接点，app/scale.mjs）" },
        "upper": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "layer": { "type": "object", "required": ["name"], "additionalProperties": false, "patternProperties": { "^_": {} },
      "properties": { "name": { "$ref": "#/$defs/str" }, "sub": { "type": "string" }, "alt": { "type": "string" }, "name_en": { "type": "string" }, "sub_en": { "type": "string" }, "alt_en": { "type": "string" } } },
    "view": { "type": "object", "required": ["extent_m"], "additionalProperties": false,
      "properties": {
        "focus": { "type": "string" }, "width_m": { "type": "number", "exclusiveMinimum": 0 }, "min_width_m": { "type": "number", "exclusiveMinimum": 0 },
        "extent_m": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "phone": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 }, "description": "手机竖屏首屏取景 [x, y, w, h]（归一化）" } } },
    "cover": { "type": "object", "required": ["src"], "additionalProperties": false,
      "properties": { "src": { "$ref": "#/$defs/path" }, "src_800": { "$ref": "#/$defs/path" }, "alt": { "type": "string" }, "alt_en": { "type": "string" } } },
    "overlay": { "type": "object", "required": ["type"], "additionalProperties": false,
      "properties": { "type": { "enum": ["dzi", "barriers"] }, "src": { "$ref": "#/$defs/path" }, "label": { "type": "string" }, "label_en": { "type": "string" }, "from": { "$ref": "#/$defs/id" } } },
    "alt": { "type": "object", "required": ["base"], "additionalProperties": false,
      "properties": { "label": { "type": "string" }, "label_en": { "type": "string" }, "base": { "$ref": "#/$defs/path" } } },
    "periods": { "type": "object", "minProperties": 1,
      "description": "多时段底图（按时段自动换，app/nav.mjs）：键是时段档位（map/tavern/mvu.mjs todPhase 的四档：dawn / day / dusk / night），值是该时段的底图 DZI；没配的档位 / 读不到世界时间 / 用户关掉时段色调开关时用 base。只换底图，视角、标记、叠加层都不动（与 alt 同机制）",
      "propertyNames": { "enum": ["dawn", "day", "dusk", "night"] },
      "additionalProperties": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.dzi$" }] } },
    "link": { "type": "object", "required": ["map"], "additionalProperties": false, "description": "跨层通道（地点卡里的「去…」链接）",
      "properties": { "map": { "$ref": "#/$defs/id" }, "marker": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "label_en": { "type": "string" } } },
    "link3d": { "type": "object", "required": ["map"], "additionalProperties": false, "description": "三维模型入口（指向 viewer3d 条目，与 link 并存）",
      "properties": { "map": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "label_en": { "type": "string" } } },
    "gallery": { "type": "object", "required": ["id"], "additionalProperties": false, "description": "房间图集入口（data/room_galleries.json 的键）",
      "properties": { "id": { "$ref": "#/$defs/str" }, "label": { "type": "string" }, "label_en": { "type": "string" } } },
    "inset": { "type": "object", "required": ["id", "base", "bounds", "res_px"], "additionalProperties": false, "description": "局部高清插图：只在放大到某个小范围（如一座庄园）时叠加一张更高分辨率的瓦片图，避免整张底图为了这一小块而放大到糊",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "marker": { "$ref": "#/$defs/id", "description": "对应的标记 id（放大到它附近才会加载这张插图；到达清晰度上限时的提示文案也从这个标记的 name 生成）" },
        "base": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.dzi$" }], "description": "插图瓦片（tools/make_dzi.py 切出）" },
        "bounds": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 }, "description": "插图在底图上的范围 [x0,y0,x1,y1]（归一化，左上原点，与 markers 的 nx/ny 同一坐标系）" },
        "res_px": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 }, "description": "插图原始像素尺寸 [宽, 高]，清晰度上限按它算（而不是按底图）" } } },
    "marker": { "type": "object", "required": ["name", "tag", "src", "alias"], "additionalProperties": false, "patternProperties": { "^_": {} },
      "properties": {
        "name": { "$ref": "#/$defs/str" }, "name_en": { "type": "string" }, "sub": { "type": "string" }, "sub_en": { "type": "string" },
        "tag": { "enum": ["set", "inf"], "description": "set = 卡里写明" },
        "cls": { "enum": ["capital"] },
        "src": { "$ref": "#/$defs/str", "description": "出处" }, "sub_src": { "type": "string" }, "layer_src": { "type": "string" },
        "alias": { "$ref": "#/$defs/strListNE" },
        "canon": { "type": "boolean" },
        "openings": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "卡的开局编号（这处地点在哪几个开局里出现）" },
        "opening_dest": { "type": "boolean" },
        "econ": { "type": "string" }, "econ_en": { "type": "string" },
        "island": { "$ref": "#/$defs/id", "description": "该标记对应的岛表 id（blender/data/tc_islands.json 的 id）：纵深数据按岛算 d，前端据此调标签不透明度（label 通道）与视差（parallax 通道）" },
        "link": { "$ref": "#/$defs/link" }, "link3d": { "$ref": "#/$defs/link3d" }, "gallery": { "$ref": "#/$defs/gallery" }, "cover": { "$ref": "#/$defs/cover" } } },
    "map": { "type": "object", "required": ["title", "kind"], "additionalProperties": false, "patternProperties": { "^_": {} },
      "properties": {
        "title": { "$ref": "#/$defs/str" }, "title_en": { "type": "string" },
        "kind": { "enum": ["world", "points", "estate"] },
        "status": { "enum": ["planned"], "description": "planned = 还没上线（不检查底图 / 数据）" },
        "parent": { "$ref": "#/$defs/id" }, "group": { "$ref": "#/$defs/id" }, "layer": { "$ref": "#/$defs/layer" },
        "base": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.dzi$" }] },
        "data": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.json$" }], "description": "points 地图的渲染数据（schema/points.schema.json）" },
        "depth": { "type": "string", "pattern": "^data/[a-z0-9_]+_depth\\.json$", "description": "纵深系统数据（schema/depth.schema.json，docs/design/depth-system.md）" },
        "src": { "$ref": "#/$defs/path", "description": "kind=estate：子页（相对 map/）" }, "src_note": { "type": "string" },
        "viewer3d": { "$ref": "#/$defs/id", "description": "props/<id>/manifest.json 的三维条目" },
        "anchor": { "type": "object", "required": ["zone"], "additionalProperties": false, "properties": { "zone": { "$ref": "#/$defs/id", "description": "kind=estate 三维页：它在父级三维视图里所在的区域 id（map/estate/model/zones.json）；兼容层把它写成节点的 anchor（K-R31 / K-R32）" } } },
        "site": { "type": "boolean" },
        "view": { "$ref": "#/$defs/view" }, "focus": { "type": "string" },
        "overlay": { "$ref": "#/$defs/overlay" }, "alt": { "$ref": "#/$defs/alt" }, "periods": { "$ref": "#/$defs/periods" }, "cover": { "$ref": "#/$defs/cover" },
        "rooms": { "$ref": "#/$defs/strListNE" }, "rooms_en": { "$ref": "#/$defs/strListNE" },
        "areas": { "$ref": "#/$defs/strListNE" }, "areas_en": { "$ref": "#/$defs/strListNE" },
        "alias": { "$ref": "#/$defs/strList" }, "districts": { "$ref": "#/$defs/strListNE" },
        "econ": { "type": "string" }, "econ_en": { "type": "string" },
        "credit": { "type": "string" }, "credit_en": { "type": "string" },
        "markers": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/marker" } },
        "insets": { "type": "array", "items": { "$ref": "#/$defs/inset" }, "description": "局部高清插图列表（app/insets.mjs）" } } }
  }
}
