{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "addon_places.schema.json",
  "title": "世界书附加条目的地点 map/data/addon_places.json（tools/build_worldbook_addon.py 读）",
  "type": "object",
  "required": ["places"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "places": { "type": "array", "items": { "type": "object", "required": ["id", "name", "alias", "text", "use"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "alias": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "text": { "type": "string", "minLength": 1, "description": "整段正文：世界书条目正文与记录卡里的说明段都取它" },
        "use": { "type": "string", "minLength": 8, "description": "记录级说明：一句话（不超过 90 字），只许用 text 里已有的字（PLACE-1b；tests/place_record.test.mjs 逐字对拍）。地点卡与地点页显示它，条目正文仍只取 text" },
        "refs": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" }, "description": "对应的地图标记 <地图 id>.<标记 id>" },
        "estate": { "type": "boolean" }, "site": { "type": "boolean" } } } }
  }
}
