# 多实例：复制为 tools/cloud/hosts/<自定义名>.env（该目录下 *.env 已在 .gitignore 里，example.env.example 不算），
# 内容格式与 tools/cloud/remote.env.example 一样，外加可选 PRICE_PER_HOUR（元/小时，status.sh 算花费用）。
# 用 --host <自定义名> 让 sync.sh / render.sh / render_split.sh / status.sh / stop.sh / setup.sh / doctor.sh 都指到这台实例；
# 不传 --host 时用默认的 tools/cloud/remote.env（相当于 --host default）。
HOST=connect.example-region-2.autodl.com
PORT=12345
USER=root
KEY=~/.ssh/autodl_ed25519
REMOTE_DIR=/root/autodl-tmp/eden
PRICE_PER_HOUR=2.5
