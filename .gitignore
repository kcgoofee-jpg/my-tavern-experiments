__pycache__/

# OSM 原始数据（python3 blender/tc_osm.py fetch 重新下载；处理后的 city.json 进 git）
blender/data/osm/raw/
# CC0 贴图（本地素材缓存；早期由 tools/fetch_textures.sh 下载，该脚本未建/已不存在，现行贴图走 blender/data/landmarks/ 那批）
blender/data/tex/
worldbook/
map/_test_*.html
logs/
# 纽约 3D 建筑模型原始 CityGML（python3 blender/tc_real3d.py fetch 重新下载；处理后的 data/real3d/*.npz 进 git）
blender/data/real3d/raw/
# 浏览器测试依赖（cd tools/browser && npm install）
tools/browser/node_modules/
# tools/browser/package-lock.json 入库：CI 的 browser-smoke 用 npm ci，需要它
blender/data/estate2/
blender/data/props
blender/data/props/
# 地标 / 庄园建模用的 CC0 贴图与 HDRI（2026-09-27 下载，27 MB；仓库里没有脚本按这个路径取用，属于本地素材缓存）
blender/data/landmarks/
node_modules
# 云渲染 SSH 连接信息（真实 HOST/PORT/KEY），照 tools/cloud/remote.env.example 填
tools/cloud/remote.env
blender/islands/out/
blender/world/out/
# 多实例云渲染连接信息（tools/cloud/hosts/<名>.env），照 tools/cloud/hosts/example.env.example 填
tools/cloud/hosts/*.env
!tools/cloud/hosts/example.env.example
# 云脚本本地锁文件
tools/cloud/.locks/
.cache/
# AI 助手的工作目录：agent 团队/会话状态（不是项目内容，2026-09-29 误提交过一次，这里挡住）
.codebuddy/
# 道具导出的烘焙中间贴图（2026-09-29 误提交过一次，这里挡住；成品是 glb，贴图打包在 glb 里）
map/props/*/*_tex/
# rsync 传输中的临时文件（map/art/.xxx.png.XXXXXX；2026-09-29 误提交过一个 24 MB 的）
map/art/.*
# Python 工具链缓存（ruff）
.ruff_cache/
# 地标草稿/看板的渲染中间图（landmark.py 先渲到这里再收进 docs/，避免云端写绝对路径）
map/art/_*.jpg
repomix-output.xml
# 浏览器探针在 docs/drafts 下的目录式临时暂存（截图成品过审后逐个 add，暂存目录不入库；2026-09-30 props_u12 残留过一次）
docs/drafts/*/tmp/
docs/drafts/props_u12_/
# AI 助手工作目录（dynamic workflows / 会话状态；同 .claude/.codebuddy/.pi 一类）
.zcode/

# 浏览器探针输出（截图 / results.json / summary.md），不入库
tools/browser/out-*/
# 上层岛表落地（tools/upper_layout_land.py）的合成前备份与旧岛心存档：临时文件，落地提交后可删
map/art/*.pre-v16C.*
